# Copy this file to .env and fill in your values before running docker-compose.
# Never commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=restaurantpos
POSTGRES_USER=pos
POSTGRES_PASSWORD=change_me_in_production

# ── Ktor server ───────────────────────────────────────────────────────────────
# REQUIRED: generate a strong secret, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change_me_in_production_32_chars_min

# Port the server listens on (host-side mapping)
SERVER_PORT=8080

# CORS origins (comma-separated, or * for development only)
CORS_ORIGINS=*
